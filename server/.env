# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration Options:
# DB_TYPE options: "auto" (default: checks MongoDB, falls back to embedded local storage) | "mongodb" | "mysql" | "local"
DB_TYPE=auto

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
# Example Local: mongodb://127.0.0.1:27017/product_crud_db
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abc.mongodb.net/product_crud_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/product_crud_db

# MySQL Connection Details (if using DB_TYPE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=product_crud_db
